{
  "hosting": {
    "public": "build/web",
    "headers": [
      {
        "source": "index.html",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache"}
        ]
      },
      {
        "source": "main.dart.js",
        "headers": [
          {"key": "Cache-Control", "value": "max-age=0, must-revalidate"}
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
